{
  "name": "simpeek",
  "version": "0.1.0",
  "description": "Stream, query and inspect iOS Simulator network traffic (GraphQL-aware) from the CLI or MCP.",
  "type": "module",
  "bin": {
    "simpeek": "bin/simpeek.js"
  },
  "files": [
    "bin",
    "dist",
    "vendor"
  ],
  "scripts": {
    "build": "node --no-warnings scripts/build.js",
    "prepack": "sh ../ios/scripts/build-dylib.sh && npm run build"
  },
  "engines": {
    "node": ">=24"
  },
  "os": [
    "darwin"
  ],
  "keywords": [
    "ios",
    "simulator",
    "network",
    "graphql",
    "urlsession",
    "mcp",
    "har"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ruby109/Simpeek.git"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.7"
  }
}
